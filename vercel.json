{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web-app && npm install",
  "buildCommand": "cd web-app && npm run build",
  "outputDirectory": "web-app/dist",
  "rewrites": [{ "source": "/((?!assets/|sfx/|.*\\..*).*)", "destination": "/index.html" }]
}
